# =========================================
# PROFESSOR MVP - Environment Configuration
# =========================================
# Copy this file to .env and fill in your values

# =========================================
# REQUIRED - OpenAI (for AI features)
# =========================================
OPENAI_API_KEY=sk-your-openai-api-key-here

# =========================================
# REQUIRED - Security Keys
# =========================================
SECRET_KEY=generate-a-32-char-secret-key-here
ENCRYPTION_KEY=generate-a-32-byte-encryption-key

# =========================================
# OPTIONAL - WhatsApp Notifications (Twilio)
# =========================================
# Get these from https://console.twilio.com
# 1. Sign up for Twilio (free trial available)
# 2. Go to Console Dashboard → Copy Account SID and Auth Token
# 3. Navigate to: Messaging → Try it out → Send a WhatsApp message
# 4. Follow sandbox setup instructions
# 
# Once configured, users just add their phone number in Settings
# and they'll automatically receive notifications.

TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# =========================================
# OPTIONAL - Google OAuth
# =========================================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# =========================================
# DATABASE (Usually no changes needed)
# =========================================
DATABASE_URL=postgresql+asyncpg://professor:professor_dev_password@postgres:5432/professor

# =========================================
# REDIS (Usually no changes needed)
# =========================================
REDIS_URL=redis://redis:6379

# =========================================
# TEMPORAL (Usually no changes needed)
# =========================================
TEMPORAL_HOST=temporal:7233
