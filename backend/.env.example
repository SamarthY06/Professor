# =========================================
# PROFESSOR MVP - Environment Configuration
# =========================================
# Copy this file to backend/.env and fill in your values.
#
# Legend:
#   REQUIRED    — Must be set for the backend Settings model to load, for
#                 production/staging validation, or for docker-compose (noted).
#   OPTIONAL    — Omitted or defaults apply; enable when you need the feature.
# =========================================

# -----------------------------------------
# REQUIRED — Security (backend)
# -----------------------------------------
# Use cryptographically random values. ENCRYPTION_KEY must be at least 32
# characters. In production/staging, SECRET_KEY must be >= 16 chars and must
# not contain weak substrings (see settings.py).
SECRET_KEY=
ENCRYPTION_KEY=

# -----------------------------------------
# REQUIRED in production/staging — OpenAI
# OPTIONAL in development if you do not call the API
# -----------------------------------------
OPENAI_API_KEY=

# -----------------------------------------
# REQUIRED — External RAG service (no defaults in app settings)
# -----------------------------------------
RAG_BASE_URL=http://localhost:8001
RAG_ADMIN_USERNAME=
RAG_ADMIN_PASSWORD=

# -----------------------------------------
# REQUIRED — Docker Compose (set in repo-root .env or the shell)
# -----------------------------------------
# Used by postgres, temporal, backend overrides, rag-service, etc.
POSTGRES_PASSWORD=

# Grafana admin login when using the grafana service.
GRAFANA_PASSWORD=

# -----------------------------------------
# OPTIONAL — JWT / NextAuth
# -----------------------------------------
# Backend uses SECRET_KEY if unset. docker-compose `web` requires JWT_SECRET_KEY for NEXTAUTH_SECRET.
JWT_SECRET_KEY=

# -----------------------------------------
# OPTIONAL — Application
# -----------------------------------------
ENVIRONMENT=development
DEBUG=true
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# -----------------------------------------
# OPTIONAL — Database / Redis / Temporal (defaults match docker service names)
# -----------------------------------------
# If you set these explicitly, use the same password as POSTGRES_PASSWORD in the URL.
DATABASE_URL=postgresql+asyncpg://professor:CHANGEME@postgres:5432/professor
DATABASE_URL_SYNC=postgresql://professor:CHANGEME@postgres:5432/professor
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
TEMPORAL_HOST=temporal:7233
TEMPORAL_PORT=7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=professor-queue

# -----------------------------------------
# OPTIONAL — OpenAI models (defaults in settings.py)
# -----------------------------------------
# OPENAI_MODEL=gpt-4.1
# OPENAI_MODEL_MINI=gpt-4.1-mini

# -----------------------------------------
# OPTIONAL — RAG tuning (defaults in settings.py)
# -----------------------------------------
# RAG_REQUEST_TIMEOUT=30
# RAG_POLL_INTERVAL_SECONDS=5
# RAG_SEARCH_LIMIT=6
# RAG_SUMMARY_CHUNKS=3

# -----------------------------------------
# OPTIONAL — Google OAuth
# -----------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------
# OPTIONAL — Email (Resend)
# -----------------------------------------
# RESEND_API_KEY=
# VERIFICATION_FROM_EMAIL=Professor <noreply@professoros.com>

# -----------------------------------------
# OPTIONAL — WhatsApp (Twilio)
# -----------------------------------------
# https://console.twilio.com — sandbox or approved WhatsApp sender.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# -----------------------------------------
# OPTIONAL — Monitoring
# -----------------------------------------
# SENTRY_DSN=

# -----------------------------------------
# OPTIONAL — Storage paths (container defaults)
# -----------------------------------------
# PDF_STORAGE_PATH=/app/data/pdfs
# LOG_STORAGE_PATH=/app/data/logs
# CACHE_STORAGE_PATH=/app/data/cache
# MAX_FILE_SIZE_MB=50
